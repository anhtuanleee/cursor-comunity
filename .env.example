DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require

# Optional public RSS/Atom feeds for creative content ingestion.
# Use comma-separated URLs or a JSON array with per-source metadata:
# Extra feeds are crawled into the audit queue but do not publish automatically.
# Add a source to partykit/ingestion/creative-feed/curated-sources.ts after review.
# CREATIVE_FEEDS=https://example.com/feed.xml,https://another.example/rss
# CREATIVE_FEEDS=[{"url":"https://example.com/feed.xml","category":"Brand Inspiration","tags":["typography","branding"]}]
CREATIVE_FEEDS=

# Protects the Vercel/Node ingestion endpoint from unauthorised calls.
INGEST_CRON_SECRET=

# Optional copyright-safe metadata enrichment for gallery items.
# Gemini receives title + a bounded RSS excerpt and returns an original summary/tags.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Optional in production: the deploy script detects the workers.dev URL.
# Set this when the realtime Worker uses a custom domain.
# NEXT_PUBLIC_PARTYKIT_HOST=https://realtime.example.com

# Optional for non-interactive/CI deployments. Local CLI login also works.
# VERCEL_TOKEN=
# CLOUDFLARE_API_TOKEN=
