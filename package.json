{
  "name": "cursor-comunity",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app partykit --ext .js,.jsx,.ts,.tsx",
    "worker:types": "wrangler types --config wrangler.jsonc --env-file .env.example --include-runtime false partykit/worker-configuration.d.ts",
    "partykit:dev": "wrangler dev --config wrangler.jsonc",
    "partykit:deploy": "wrangler deploy --config wrangler.jsonc",
    "deploy": "node scripts/deploy.mjs"
  },
  "dependencies": {
    "@vercel/analytics": "^2.0.1",
    "clsx": "^2.1.0",
    "framer-motion": "^11.0.0",
    "lenis": "^1.3.25",
    "next": "^15.5.21",
    "postgres": "^3.4.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260727.1",
    "@types/node": "^20.12.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "eslint": "^8.57.1",
    "eslint-config-next": "^15.5.21",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.4.0",
    "wrangler": "^4.0.0"
  },
  "overrides": {
    "postcss": "$postcss",
    "sharp": "0.35.2"
  }
